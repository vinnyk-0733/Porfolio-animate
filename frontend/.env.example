# Copy to .env.local and configure private server-side values.
# Use your own MongoDB connection URI; never commit database credentials.
MONGODB_URI=
MONGODB_DB=portfolio_db

# Optional override: otherwise the server manages a random session key in MongoDB.
# If supplied, use a unique random secret with at least 32 characters.
# Example command: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
